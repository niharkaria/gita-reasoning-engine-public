# Dockerfile.api
#
# Why this file exists:
#   Builds the FastAPI serving image. Deliberately does NOT install the
#   `ingestion` extra (PyMuPDF/PaddleOCR) — those run on Kaggle, not in the
#   served API — keeping this image smaller and avoiding OCR system deps
#   (Poppler, etc.) in production.
#
# Multi-stage build: `uv` resolves/installs into a venv in the builder
# stage; only the venv + source are copied into the slim runtime stage.

FROM python:3.12-slim AS builder

RUN pip install --no-cache-dir uv

WORKDIR /build
COPY pyproject.toml ./
COPY src ./src
COPY README.md ./

RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN uv pip install --python /opt/venv/bin/python ".[eval]"

FROM python:3.12-slim AS runtime

RUN useradd --create-home --uid 1000 appuser
WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY src ./src
COPY pyproject.toml ./

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER appuser
EXPOSE 8000

CMD ["uvicorn", "gita_engine.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
