# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL (+ pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gita_engine
POSTGRES_USER=gita_engine
POSTGRES_PASSWORD=changeme

# --- Neo4j (deferred per Phase 3 ADR — placeholder only) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Embedding / Reranking / Generation ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
GENERATION_MODEL=Qwen/Qwen2.5-Instruct     # exact hosting decision pending (Phase 3 open item)
HF_API_TOKEN=

# --- Evaluation / Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Kaggle (used only in kaggle/ notebooks, not by the API) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
